{
  "name": "agent-collective",
  "version": "0.3.1",
  "description": "Opt-in, session-scoped peer awareness and communication for omp and pi. Join with /collective; otherwise remain disconnected.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "npx --yes -p typescript@5.7.3 tsc --noEmit --strict --skipLibCheck --module esnext --target es2022 --moduleResolution bundler index.ts",
    "package:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "agent-coordination",
    "callsign",
    "coding-agent",
    "cross-harness",
    "hub",
    "irc",
    "multi-agent",
    "omp",
    "omp-extension",
    "peer-discovery",
    "pi",
    "pi-coding-agent",
    "pi-extension"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.1.0 <19.0.0",
    "@earendil-works/pi-coding-agent": ">=0.80.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GarrettFaucher/agent-collective.git"
  },
  "bugs": {
    "url": "https://github.com/GarrettFaucher/agent-collective/issues"
  },
  "homepage": "https://github.com/GarrettFaucher/agent-collective#readme",
  "author": "andreiverdes (https://github.com/andreiverdes)",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
